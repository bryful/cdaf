#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
IDI_APP ICON "assets\\findCD.ico"

IDD_MAIN DIALOGEX 0, 0, 300, 30
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "findCD"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SEARCH, "Edit", ES_AUTOHSCROLL | WS_TABSTOP, 10, 9, 280, 12
    CONTROL "L", IDC_LEFT, "Button", BS_OWNERDRAW | WS_GROUP | WS_TABSTOP, 250, 6, 20, 17
    CONTROL "R", IDC_RIGHT, "Button", BS_OWNERDRAW | WS_TABSTOP, 274, 6, 20, 17
    LISTBOX IDC_RESULTS, 12, 9, 276, 130, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | NOT WS_BORDER
END
